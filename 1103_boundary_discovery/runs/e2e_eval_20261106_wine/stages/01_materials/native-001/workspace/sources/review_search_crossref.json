duction"],"language":"en","link":[{"URL":"http:\/\/link.springer.com\/content\/pdf\/10.1007\/978-1-4757-6967-8_2","content-type":"unspecified","content-version":"vor","intended-application":"similarity-checking"}],"deposited":{"date-parts":[[2013,10,21]],"date-time":"2013-10-21T16:01:46Z","timestamp":1382371306000},"score":23.799454,"resource":{"primary":{"URL":"http:\/\/link.springer.com\/10.1007\/978-1-4757-6967-8_2"}},"issued":{"date-parts":[[1999]]},"ISBN":["9781475769692","9781475769678"],"references-count":0,"URL":"https:\/\/doi.org\/10.1007\/978-1-4757-6967-8_2","published":{"date-parts":[[1999]]}},{"indexed":{"date-parts":[[2026,4,14]],"date-time":"2026-04-14T11:31:04Z","timestamp":1776166264894,"version":"3.50.1"},"posted":{"date-parts":[[2026,4,14]]},"group-title":"Mathematics","reference-count":0,"publisher":"Cambridge University Press (CUP)","license":[{"start":{"date-parts":[[2026,4,14]],"date-time":"2026-04-14T00:00:00Z","timestamp":1776124800000},"content-version":"unspecified","delay-in-days":0,"URL":"https:\/\/www.cambridge.org\/engage\/miir\/legal-information?show=terms-of-use"}],"content-domain":{"domain":[],"crossmark-restriction":false},"accepted":{"date-parts":[[2026,1,27]]},"abstract":"<jats:p>This report addresses a challenge proposed by Comiss\u00e3o de Viticultura da Regi\u00e3o dos Vinhos Verdes (CVRVV) at the 181st European Study Group in Industry. Here we investigate the refinement of the sensory evaluation methodology of wine employed by the CVRVV laboratory, with a focus on improving statistical rigor and tasters' assessments. We perform a detailed statistical analysis of the sensory evaluation data, including measures of central tendency, dispersion, and distribution, to identify sources of variability. We also develop a script to assess tasters consistency by analyzing deviations from the panel median and repeatability across tests. These approaches improve the aggregation of sensory data, detect errors, and establish sound statistical criteria for sample validation and test series acceptance, ensuring more precise and reliable sensory analysis.<\/jats:p>","DOI":"10.33774\/miir-2026-vt4px","type":"posted-content","created":{"date-parts":[[2026,4,14]],"date-time":"2026-04-14T10:14:12Z","timestamp":1776161652000},"source":"Crossref","is-referenced-by-count":0,"title":["Enhancing Wine Sensory Evaluation]{Enhancing Wine Sensory Evaluation: Develop a Robust System for Consistent and Accurate Taster Scores"],"prefix":"10.33774","author":[{"given":"Afonso","family":"Costa","sequence":"first","affiliation":[{"name":"CMUC"}],"role":[{"role":"author","vocabulary":"crossref"}]},{"given":"Alexandra","family":"Gavina","sequence":"additional","affiliation":[{"name":"LEMA-ISEP"}],"role":[{"role":"author","vocabulary":"crossref"}]},{"given":"Alzira","family":"Mota","sequence":"additional","affiliation":[{"name":"ISEP"}],"role":[{"role":"author","vocabulary":"crossref"}]},{"ORCID":"https:\/\/orcid.org\/0000-0002-3292-0624","authenticated-orcid":false,"given":"Ana","family":"Moura","sequence":"additional","affiliation":[{"name":"LEMA-ISEP"},{"name":"CMUP"}],"role":[{"role":"author","vocabulary":"crossref"}]},{"ORCID":"https:\/\/orcid.org\/0000-0001-5803-9168","authenticated-orcid":false,"given":"C\u00e1tia","family":"Dias","sequence":"additional","affiliation":[{"name":"ISEL"}],"role":[{"role":"author","vocabulary":"crossref"}]},{"ORCID":"https:\/\/orcid.org\/0000-0003-4032-7019","authenticated-orcid":false,"given":"Lu\u00eds","family":"Afonso","sequence":"additional","affiliation":[{"name":"ISRC-ISEP"}],"role":[{"role":"author","vocabulary":"crossref"}]},{"ORCID":"https:\/\/orcid.org\/0000-0001-9577-0347","authenticated-orcid":false,"given":"Nuno","family":"Lopes","sequence":"additional","affiliation":[{"name":"CEMAT"},{"name":"ISEL"}],"role":[{"role":"author","vocabulary":"crossref"}]}],"member":"56","link":[{"URL":"https:\/\/www.cambridge.org\/engage\/api-gateway\/miir\/assets\/orp\/resource\/item\/6978e2913d