  "decisions": {
    "personal": {
      "base": {
        "id": "personal:sensorimotor_biologist",
        "owner": "sensorimotor_biologist",
        "version": 1
      },
      "action": "revise",
      "question": "在R07中，两个追踪标签的相对距离、各自位移及坐标位移方向相似度如何随帧变化？这些坐标描述是否能区分距离转移与共同运动，而不将其命名为感觉引导行为？",
      "reason": "同伴提出距离变化无法识别单体运动贡献；同时R07已有完整位置数组元数据。将问题收窄到R07并明确分开距离、个体位移和坐标方向相似度，使运动学问题更可执行。方向相似度仍只是候选描述量。",
      "influenced_by": [
        {
          "id": "personal:animal_behaviorist",
          "owner": "animal_behaviorist",
          "version": 1
        },
        {
          "id": "shared:discussion",
          "owner": "shared",
          "version": 1
        }
      ]
    },
    "shared": {
      "base": {
        "id": "shared:discussion",
        "owner": "shared",
        "version": 1
      },
      "action": "revise",
      "question": "在R07中，记录内较近与较远的A-B距离状态之后10帧，距离变化分布是否不同？并列描述A、B各自位移；若计算方向相似度，将其限定为坐标位移方向描述，不解释为鱼体朝向或追随。",
      "reason": "保留可执行的近远状态比较和单体位移并列报告，并明确方向相似度的可观察范围，避免将图像平面运动方向扩展成感觉运动状态。",
      "influenced_by": [
