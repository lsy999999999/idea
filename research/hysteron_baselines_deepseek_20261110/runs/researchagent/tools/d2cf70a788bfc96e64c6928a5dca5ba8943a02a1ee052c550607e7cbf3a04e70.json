{
  "name": "analyze_csv",
  "args": {
    "dataset": "measurements",
    "group_column": "spring_id",
    "group_value": "S007",
    "variables": [
      {
        "name": "xm",
        "expression": "mean(x_m)"
      },
      {
        "name": "fm",
        "expression": "mean(force_N)"
      },
      {
        "name": "xc",
        "expression": "x_m - xm"
      },
      {
        "name": "fc",
        "expression": "force_N - fm"
      },
      {
        "name": "slope",
        "expression": "sum(xc*fc)/sum(xc*xc)"
      },
      {
        "name": "icpt",
        "expression": "fm - slope*xm"
      },
      {
        "name": "res",
        "expression": "force_N - (slope*x_m + icpt)"
      }
    ],
    "outputs": [
      {
        "name": "slope_N_per_cm",
        "expression": "slope*100"
      },
      {
        "name": "intercept_N",
        "expression": "icpt"
      },
      {
        "name": "max_abs_resid_N",
        "expression": "max(abs(res))"
      },
      {
        "name": "rms_resid_N",
        "expression": "sqrt(mean(res*res))"
      }
    ]
  },
