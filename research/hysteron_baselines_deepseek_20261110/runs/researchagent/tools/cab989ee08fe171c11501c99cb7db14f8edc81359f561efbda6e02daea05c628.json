    "variables": [
      {
        "name": "xb",
        "expression": "x_m-mean(x_m)"
      },
      {
        "name": "fb",
        "expression": "force_N-mean(force_N)"
      },
      {
        "name": "slope",
        "expression": "sum(xb*fb)/sum(xb*xb)"
      },
      {
        "name": "icept",
        "expression": "mean(force_N)-slope*mean(x_m)"
      },
      {
        "name": "res",
        "expression": "force_N-(icept+slope*x_m)"
      }
    ],
    "outputs": [
      {
        "name": "k_N_per_cm",
        "expression": "slope/100"
      },
      {
        "name": "x0_cm",
