+def archive_material_sources(history, library):
+    """Preserve source versions actually read before AND during material recovery."""
+    sources, files = [], []
+    for result_path, result in history:
+        for item in result['sources']:
+            path = inside(item['local_path'])
+            if not path.is_file():
+                raise ValueError('Missing downloaded source')
+            content_hash = digest(path)
+            archive = library / (content_hash + path.suffix)
+            archive.parent.mkdir(parents=True, exist_ok=True)
+            if not archive.exists():
+                shutil.copy2(path, archive)
+            sources.append({**item, 'archived_path': str(archive),
+                            'sha256': content_hash, 'origin_result': str(result_path)})
+            if archive not in files:
+                files.append(archive)
+    return sources, files
 
 
