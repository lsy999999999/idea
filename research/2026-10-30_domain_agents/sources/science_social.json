nt and future attacks.<\/jats:p>","DOI":"10.1126\/science.adu4331","type":"journal-article","created":{"date-parts":[[2024,11,7]],"date-time":"2024-11-07T15:00:16Z","timestamp":1730991616000},"page":"709-709","update-policy":"https:\/\/doi.org\/10.34133\/aaas_crossmark","source":"Crossref","is-referenced-by-count":1,"title":["Time to take stock"],"prefix":"10.1126","volume":"386","author":[{"given":"H. Holden","family":"Thorp","sequence":"first","affiliation":[{"name":"H. Holden Thorp Editor-in-Chief, Science journals."}],"role":[{"vocabulary":"crossref","role":"author"}]}],"member":"221","container-title":["Science"],"language":"en","link":[{"URL":"https:\/\/www.science.org\/doi\/pdf\/10.1126\/science.adu4331","content-type":"unspecified","content-version":"vor","intended-application":"similarity-checking"}],"deposited":{"date-parts":[[2024,11,14]],"date-time":"2024-11-14T19:01:49Z","timestamp":1731610909000},"score":9.587053,"resource":{"primary":{"URL":"https:\/\/www.science.org\/doi\/10.1126\/science.adu4331"}},"issued":{"date-parts":[[2024,11,15]]},"references-count":0,"journal-issue":{"issue":"6723","published-print":{"date-parts":[[2024,11,15]]}},"alternative-id":["10.1126\/science.adu4331"],"URL":"https:\/\/doi.org\/10.1126\/science.adu4331","ISSN":["0036-8075","1095-9203"],"issn-type":[{"value":"0036-8075","type":"print"},{"value":"1095-9203","type":"electronic"}],"published":{"date-parts":[[2024,11,15]]},"assertion":[{"value":"2024-11-07","order":3,"name":"published","label":"Published","group":{"name":"publication_history","label":"Publication History"}}]},{"indexed":{"date-parts":[[2026,1,19]],"date-time":"2026-01-19T13:03:54Z","timestamp":1768827834872,"version":"3.49.0"},"reference-count":0,"publisher":"American Association for the Advancement of Science (AAAS)","issue":"6634","content-domain":{"domain":["www.science.org"],"crossmark-restriction":true},"short-container-title":["Science"],"published-print":{"date-parts":[[2023,2,24]]},"abstract":"<jats: