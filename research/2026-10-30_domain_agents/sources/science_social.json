sertion":[{"value":"2023-02-23","order":2,"name":"published","label":"Published","group":{"name":"publication_history","label":"Publication History"}}]},{"indexed":{"date-parts":[[2026,10,9]],"date-time":"2026-10-09T17:14:55Z","timestamp":1791566095585,"version":"4.3.4"},"reference-count":59,"publisher":"American Association for the Advancement of Science (AAAS)","issue":"6685","content-domain":{"domain":["www.science.org"],"crossmark-restriction":true},"short-container-title":["Science"],"published-print":{"date-parts":[[2024,2,23]]},"abstract":"<jats:p>\n            Forestation is widely proposed for carbon dioxide (CO\n            <jats:sub>2<\/jats:sub>\n            ) removal, but its impact on climate through changes to atmospheric composition and surface albedo remains relatively unexplored. We assessed these responses using two Earth system models by comparing a scenario with extensive global forest expansion in suitable regions to other plausible futures. We found that forestation increased aerosol scattering and the greenhouse gases methane and ozone following increased biogenic organic emissions. Additionally, forestation decreased surface albedo, which yielded a positive radiative forcing (i.e., warming). This offset up to a third of the negative forcing from the additional CO\n            <jats:sub>2<\/jats:sub>\n            removal under a 4\u00b0C warming scenario. However, when forestation was pursued alongside other strategies that achieve the 2\u00b0C Paris Agreement target, the offsetting positive forcing was smaller, highlighting the urgency for simultaneous emission reductions.\n          <\/jats:p>","DOI":"10.1126\/science.adg6196","type":"journal-article","created":{"date-parts":[[2024,2,22]],"date-time":"2024-02-22T18:59:56Z","timestamp":1708628396000},"page":"860-864","update-policy":"https:\/\/doi.org\/10.34133\/aaas_crossmark","source":"Crossref","is-referenced-by-count":96,"title":["Chemistry-albedo feedbacks offset up to a third of forestation\u2019s CO\n            <sub>2<\/sub>\n            removal benefits"],"prefix":"10.1126","volume":"383","author":[{"ORCID":"https:\/\/orcid.org\/0000-0003-0643-2026","authenticated-orcid":true,"given":"James","family":"Weber","sequence":"first","affiliation":[{"name":"Leverhulme Centre for Climate Change Mitigation, School of Biosciences, University of Sheffield, Sheffield S10 2TN, UK."}],"role":[{"vocabulary":"crossref","role":"author"}]},{"ORCID":"https:\/\/orcid.org\/0000-0001-8825-0183","authenticated-orcid":true,"given":"James A.","family":"King","sequence":"additional","affiliation":[{"name":"Leverhulme Centre for Climate Change Mitigation, School of Biosciences, University of Sheffield, Sheffield S10 2TN, UK."}],"role":[{"vocabulary":"crossref","role":"author"}]},{"ORCID":"https:\/\/orcid.org\/0000-0003-3750-3544","authenticated-orcid":true,"given":"Nathan Luke","family":"Abraham","sequence":"additional","affiliation":[{"name":"Centre for Atmospheric Science, Yusuf Hamied Department of Chemistry, University of Cambridge, Cambridge CB2 1EW, UK."},{"name":"National Centre for Atmospheric Science, Yusuf Hamied Department of Chemistry, University of Cambridge, Cambridge CB2 1EW, UK."}],"role":[{"vocabulary":"crossref","role":"author"}]},{"ORCID":"https:\/\/orcid.org\/0000-0002-4919-7751","authenticated-orcid":true,"given":"Daniel P.","family":"Grosvenor","sequence":"additional","affiliation":[{"name":"Centre for Environmental Modelling and Computation (CEMAC), School of Earth and Environment, University of Leeds, Leeds LS2 9JT, UK."},{"name":"Met Office Hadley Centre, Exeter EX1 3PB, UK."}],"role":[{"vocabulary":"crossref","role":"author"}]},{"ORCID":"https:\/\/orcid.org\/0000-0003-0599-4633","authenticated-orcid":true,"given":"Christopher J.","family":"Smith","sequence":"additional","affiliation":[{"name":"Institute for Climate and Atmospheric Science, School of Earth and Environment, University of Leeds, Leeds LS2 9JT, UK."},{"name":"International Institut