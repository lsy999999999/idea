Notebook[{
Cell[TextData[StyleBox["This custom code accompanies the article, \
\[OpenCurlyDoubleQuote]Mechanical hysterons with tunable interactions of \
general sign\[CloseCurlyDoubleQuote], by Joseph D. Paulsen (submitted 2025).\n\
\nThe following blocks calculate the switching thresholds for two coupled \
hysterons using the exact kinematic model. Parameter values are from the \
experiments in Fig. 3. The results shown at the bottom of the notebook are \
the kinematic model predictions for the \[OpenCurlyDoubleQuote]latching\
\[CloseCurlyDoubleQuote] behavior in Fig. 3B. \n\nBy adjusting the \
experimental values, this code can also be used to reproduce the kinematic \
model predictions in Fig. S1. By adding a loop over the l values using the \
Table[] command, one can reproduce the curves for Fig. 2 and Fig. S3. ",
 FontSlant->"Italic"]], "Text",
 CellChangeTimes->{{3.972856734950976*^9, 3.97285685819109*^9}, {
  3.9728569843929243`*^9, 3.9728570251808243`*^9}, {3.9728570656639977`*^9, 
  3.972857188403103*^9}, {3.97285724816228*^9, 3.97285730098032*^9}, {
  3.972857636968951*^9, 3.972857712933363*^9}, {3.972857743976369*^9, 
  3.9728578620071373`*^9}},ExpressionUUID->"539f1db9-faf8-498b-b9f4-\
723831c9a3b5"],

Cell[CellGroupData[{

Cell["Formulas and parameters for two coupled hysterons", "Subsection",
 CellChangeTimes->{{3.9728541257827253`*^9, 
  3.9728541530903473`*^9}},ExpressionUUID->"0880673f-0486-416c-bb9a-\
9fa9c4104585"],

Cell[CellGroupData[{

Cell["General torque expressions", "Subsubsection",
 CellChangeTimes->{{3.972854037301776*^9, 
  3.9728540470114737`*^9}},ExpressionUUID->"d8401f96-d45e-49a3-8205-\
7b7c27bcce9d"],

Cell["Exact torque from one coupling spring", "Text",
 CellChangeTimes->{{3.972767085550549*^9, 3.972767094456623*^9}, {
  3.9727673158023357`*^9, 
  3.972767317961289*^9}},ExpressionUUID->"6a1789e6-9856-496e-9250-\
a5fed869773d"],

Cell[BoxData[
 RowBox[{
  RowBox[{"\[Tau]", "[", 
   RowBox[{
   "k_", ",", "x0_", ",", "w_", ",", "l1_", ",", "l2_", ",", "\[Theta]1_", ",",
     "\[Theta]2_"}], "]"}], ":=", 
  RowBox[{"k", " ", "l1", " ", 
   RowBox[{"(", 
    RowBox[{
     RowBox[{"w", " ", 
      RowBox[{"Cos", "[", "\[Theta]1", "]"}]}], "+", 
     RowBox[{"l2", " ", 
      RowBox[{"Sin", "[", 
       RowBox[{"\[Theta]2", "-", "\[Theta]1"}], "]"}]}]}], ")"}], 
   RowBox[{"(", 
    RowBox[{"1", "-", 
     FractionBox["x0", 
      SqrtBox[
       RowBox[{
        SuperscriptBox[
         RowBox[{"(", 
          RowBox[{"w", "+", 
           RowBox[{"l2", " ", 
            RowBox[{"Sin", "[", "\[Theta]2", "]"}]}], "-", 
           RowBox[{"l1", " ", 
            RowBox[{"Sin", "[", "\[Theta]1", "]"}]}]}], ")"}], "2"], "+", 
        SuperscriptBox[
         RowBox[{"(", 
          RowBox[{
           RowBox[{"l2", " ", 
            RowBox[{"Cos", "[", "\[Theta]2", "]"}]}], "-", 
           RowBox[{"l1", " ", 
            RowBox[{"Cos", "[", "\[Theta]1", "]"}]}]}], ")"}], "2"]}]]]}], 
    ")"}]}]}]], "Input",
 CellChangeTimes->{{3.972766921964992*^9, 3.972767062634614*^9}, {
  3.972767324970649*^9, 3.9727673463863792`*^9}, {3.972767507534869*^9, 
  3.972767520301548*^9}, {3.9728531675801373`*^9, 3.972853174111272*^9}},
 CellLabel->
  "In[201]:=",ExpressionUUID->"56498244-0644-4746-93bc-494912f81cfa"],

Cell["Exact torque for two coupling springs, \[OpenCurlyQuote]a\
\[CloseCurlyQuote] and \[OpenCurlyQuote]b\[CloseCurlyQuote]", "Text",
 CellChangeTimes->{{3.972853130953663*^9, 3.972853154042099*^9}, {
  3.9728532581789637`*^9, 3.972853264346902*^9}, {3.972854507899098*^9, 
  3.9728545269919043`*^9}, {3.972854975422126*^9, 
  3.9728549772488728`*^9}},ExpressionUUID->"5e4d154c-7a46-4da3-8e1b-\
ad70e337a43c"],

Cell[BoxData[
 RowBox[{
  RowBox[{"\[Tau]ij", "[", 
   RowBox[{
   "ka_", ",", "kb_", ",", "x0a_", ",", "x0b_", ",", "w_", ",", "l1_", ",", 
    "l2_", ",", "\[Theta]1_", ",", "\[Theta]2_"}], "]"}], ":=", 
  RowBox[{
   RowBox[{"\[Tau]", "[", 
    RowBox[{
    "ka", ",", "x0a", ",", "w", ",", "l1", ",", "l2", ",", "\[Theta]1", ",", 
     "\[Theta]2"}], "]"}], "+", 
   RowBox[{"\[Tau]", "[", 
    RowBox[{"kb", ",", "x0b", ",", "w", ",", 
     RowBox[{"-", "l1"}], ",", 
     RowBox[{"-", "l2"}], ",", "\[Theta]1", ",", "\[Theta]2"}], 
    "]"}]}]}]], "Input",
 CellChangeTimes->{{3.9728531599583*^9, 3.972853269765053*^9}, {
  3.972854512301241*^9, 3.972854513930653*^9}},
 CellLabel->
  "In[202]:=",ExpressionUUID->"eedcbf5f-d494-4d85-a9c5-839910194ab3"],

Cell["Exact torque from driving rod", "Text",
 CellChangeTimes->{{3.972767095633773*^9, 3.972767109183548*^9}, {
  3.9727673187123947`*^9, 
  3.972767320056204*^9}},ExpressionUUID->"e64e8066-205d-40cb-a0f0-\
afd95b1ef612"],

Cell[BoxData[
 RowBox[{
  RowBox[{"\[Tau]i", "[", 
   RowBox[{
   "ki_", ",", "x0i_", ",", "y_", ",", "xi_", ",", "L_", ",", "\[Theta]i_", ",",
     "\[Gamma]_"}], "]"}], ":=", 
  RowBox[{"L", " ", "ki", " ", 
   RowBox[{"Cos", "[", "\[Theta]i", "]"}], 
   RowBox[{"(", 
    RowBox[{"\[Gamma]", "+", "xi", "+", 
     RowBox[{"y", " ", 
      RowBox[{"Tan", "[", "\[Theta]i", "]"}]}]}], ")"}], 
   RowBox[{"(", 
    RowBox[{"1", "-", 
     FractionBox["x0i", 
      SqrtBox[
       RowBox[{
        SuperscriptBox[
         RowBox[{"(", 
          RowBox[{"\[Gamma]", "+", "xi", "-", 
           RowBox[{"L", " ", 
            RowBox[{"Sin", "[", "\[Theta]i", "]"}]}]}], ")"}], "2"], "+", 
        SuperscriptBox[
         RowBox[{"(", 
          RowBox[{"y", "+", 
           RowBox[{"L", " ", 
            RowBox[{"Cos", "[", "\[Theta]i", "]"}]}]}], ")"}], "2"]}]]]}], 
    ")"}]}]}]], "Input",
 CellChangeTimes->{{3.972767338408051*^9, 3.9727673582805557`*^9}, {
   3.972767413309907*^9, 3.9727675937217607`*^9}, {3.972775167605761*^9, 
   3.972775289727113*^9}, {3.97285258782691*^9, 3.97285261634803*^9}, {
   3.9728527423461637`*^9, 3.972852766582385*^9}, {3.972853176315207*^9, 
   3.9728531853486843`*^9}, 3.97285353479692*^9, 3.972853729996984*^9},
 CellLabel->
  "In[203]:=",ExpressionUUID->"f0a16b74-965c-4f9f-a45c-de95a5115bb4"]
}, Closed]],

