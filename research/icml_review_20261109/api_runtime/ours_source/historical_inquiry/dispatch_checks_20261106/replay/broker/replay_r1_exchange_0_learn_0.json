            "units": "原生图像坐标单位"
          },
          {
            "name": "change_10",
            "expression": "shift(distance,-10)-distance",
            "meaning": "10帧后距离减当前距离，有向距离变化",
            "units": "原生图像坐标单位/10帧"
          },
          {
            "name": "A_displacement_10",
            "expression": "norm(shift(positions[:,0,:],-10)-positions[:,0,:],axis=-1)",
            "meaning": "A在10帧间隔上的位移大小",
            "units": "原生图像坐标单位/10帧"
          },
          {
            "name": "B_displacement_10",
            "expression": "norm(shift(positions[:,1,:],-10)-positions[:,1,:],axis=-1)",
            "meaning": "B在10帧间隔上的位移大小",
            "units": "原生图像坐标单位/10帧"
          },
          {
            "name": "valid_pair",
            "expression": "isfinite(distance)&isfinite(change_10)&isfinite(A_displacement_10)&isfinite(B_displacement_10)",
            "meaning": "当前及10帧后两条坐标均可用于配对",
            "units": "boolean"
          },
          {
            "name": "near_threshold",
            "expression": "quantile(distance,0.25)",
            "meaning": "R07全记录距离第25分位数",
            "units": "原生图像坐标单位"
          },
          {
            "name": "far_threshold",
            "expression": "quantile(distance,0.75)",
            "meaning": "R07全记录距离第75分位数",
            "units": "原生图像坐标单位"
          }
        ],
        "outputs": [
          {
            "name": "distance",
            "expression": "distance"
          },
          {
            "name": "future_distance_change",
